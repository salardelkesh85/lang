// اولین برنامهٔ Nova: مبانی زبان
let نام = "دنیا"
var شمارش = 0

fun fact(n: Int): Int {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
}

fun fib(n: Int): Int {
    var a = 0
    var b = 1
    for i in 0..n {
        let t = a + b
        a = b
        b = t
    }
    return a
}

fun isPrime(n: Int): Bool {
    if n < 2 { return false }
    var d = 2
    while d * d <= n {
        if n % d == 0 { return false }
        d += 1
    }
    return true
}

fun average(xs: List<Float>): Float {
    var sum = 0.0
    for x in xs { sum += x }
    return sum / len(xs)
}

fun main() {
    print("سلام {نام}!")
    print("5! = {fact(5)}")
    print("fib(۱۰) = {fib(۱۰)}")

    var primes: List<Int> = []
    for n in 1..=30 {
        if isPrime(n) { primes = primes + [n] }
    }
    print("primes: {primes}")
    print("count: {len(primes)}, contains 7? {contains(primes, 7)}")

    let avg = average([1, 2.5, 4])
    print("average = {avg} ~ {format(avg, 2)}")
    print("7 / 2 = {7 / 2}, 7 % 3 = {7 % 3}, 7 / 2.0 = {7 / 2.0}")
    print("sqrt(2) = {sqrt(2)}")
    print("int(\"42\") + 1 = {int("42") + 1}, int(\"abc\") = {int("abc")}")

    for c in "Nova" {
        شمارش += 1
    }
    print("letters: {شمارش}")

    var i = 0
    while true {
        i += 1
        if i % 2 == 0 { continue }
        if i > 7 { break }
        print("odd {i}")
    }
}
