// اعداد: سرریز Int، تقسیم منفی، قالب Float
fun main() {
    let big = 2147483647
    print(big + 1)
    print(-7 / 2)
    print(-7 % 3)
    print(7 % -3)
    print(abs(-5))
    print(1.0 / 3)
    print(10000000.0)
    print(1234567.5)
    print(0.001)
    print(0.0001)
    print(1e20)
    print(-2.5e-7)
    print(100.0)
    print(0.1 + 0.2)
    print(5.0 % 3)
    print(1.0 / 0)
    print(-1.0 / 0)
    print(int(3.99))
    print(int(-3.99))
    print(int(1e12))
    print(float(7))
    print(float("2.5") * 2)
    print(float("x"))
    print(int(" 12 "))
    print(int("۱۲"))
    print(format(3.14159, 3))
    print(format(2.0, 0))
    print(sqrt(16))
    var f: Float = 3
    f /= 2
    print(f)
    print(f == 1.5)
    print(3 == 3.0)
    let xs = [1, 2.5]
    print(xs)
    print(-(-3))
    print(- -3.5)
    print(2 * -3)
    print((1 + 2) * (3 - 4) / 2)
    print(10 - (4 - 3))
    print(not (1 < 2) or true and false)
}
